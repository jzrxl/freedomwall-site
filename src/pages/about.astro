---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<Base title="About Us · SSU Freedom Wall">
  <div class="about-page">
    <a href="/" class="back-link">
      <Icon name="arrow-back" />
      <span>Back to the wall</span>
    </a>

    <header class="about-hero">
      <h1>
        <Icon name="sparkle" class="h1-icon" />
        About Us
        <Icon name="sparkle" class="h1-icon" />
      </h1>
      <p class="sub">A quiet space for thoughts that need somewhere to go.</p>
    </header>

    <section class="about-card">
      <div class="section-header">
        <Icon name="info" class="section-icon" />
        <h2>What is the Freedom Wall?</h2>
      </div>
      <p>
        SSU Freedom Wall is a small, anonymous space for the SSU community to
        speak freely. No names. No sign-up. No trace. Just your words, in a
        place where they can finally be heard.
      </p>
      <p>
        Whether it's something you've been holding in, a message you can't say
        out loud, or a thought you want to leave somewhere quiet — this wall is
        for you.
      </p>
    </section>

    <section class="about-card">
      <div class="section-header">
        <Icon name="pencil" class="section-icon" />
        <h2>How it works</h2>
      </div>
      <ol class="steps">
        <li>
          <span class="step-num">1</span>
          <div>
            <strong>Write your message.</strong>
            <span>Say what you need to say — up to 500 characters.</span>
          </div>
        </li>
        <li>
          <span class="step-num">2</span>
          <div>
            <strong>Preview it.</strong>
            <span>See exactly how it'll look before you send it. Nothing goes out until you say so.</span>
          </div>
        </li>
        <li>
          <span class="step-num">3</span>
          <div>
            <strong>Send it anonymously.</strong>
            <span>Your message is delivered without your name, device, or identity attached.</span>
          </div>
        </li>
      </ol>
    </section>

    <section class="about-card">
      <div class="section-header">
        <Icon name="shield" class="section-icon" />
        <h2>Our promise</h2>
      </div>
      <ul class="promises">
        <li>
          <Icon name="lock" class="promise-icon" />
          <span>Nothing is stored except your words — no names, no IPs, no device info.</span>
        </li>
        <li>
          <Icon name="users" class="promise-icon" />
          <span>Every submission is treated the same, no matter who you are.</span>
        </li>
        <li>
          <Icon name="heart" class="promise-icon" />
          <span>This wall exists to lift people up — not to tear anyone down.</span>
        </li>
      </ul>
    </section>

    <section class="about-card">
      <div class="section-header">
        <Icon name="leaf" class="section-icon" />
        <h2>Ground rules</h2>
      </div>
      <ul class="rules">
        <li>No names, no doxxing, no identifying details about others.</li>
        <li>No hate speech, threats, or harassment — anonymous or not.</li>
        <li>Be honest, be kind, be human. That's all we ask.</li>
      </ul>
      <p class="footnote">Messages that break these rules won't make it to the wall.</p>
    </section>

    <div class="credits">
      <p class="credit-line">
        Made by a Freshman from <strong>BINDTECH ELXT-1A</strong>
      </p>
      <p class="credit-line with-icon">
        <span>Made with</span>
        <svg class="astro-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="url(#astroGrad)" d="M12 1.5l2.7 7.2 7.3 1.3-5.3 5.1 1.4 7.4L12 19l-6.1 3.5 1.4-7.4L2 10l7.3-1.3L12 1.5z"/>
          <defs>
            <linearGradient id="astroGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#0054A6"/>
              <stop offset="100%" stop-color="#FFC72C"/>
            </linearGradient>
          </defs>
        </svg>
        <span>Astro</span>
      </p>
    </div>

    <Footer />
  </div>
</Base>

<style>
  .about-page { width: 100%; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.85rem;
    font-weight: 600;
    color: #6B8099;
    text-decoration: none;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: 999px;
    transition: background 0.15s, color 0.15s;
  }
  .back-link:hover { background: #EAF3FB; color: #0054A6; }
  .back-link :global(.icon) { font-size: 1.05em; }

  .about-hero { margin-bottom: 22px; }

  h1 {
    font-size: 2.4rem;
    margin-bottom: 6px;
  }

  .sub { margin-bottom: 0; }

  .about-card {
    background: #FFFFFF;
    border: 1px solid #D5E3F2;
    border-radius: var(--radius);
    padding: 22px 22px;
    box-shadow: var(--shadow);
    margin-bottom: 16px;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 0.55em;
    margin-bottom: 14px;
  }

  .section-icon {
    font-size: 1.2rem;
    color: #0054A6;
    flex-shrink: 0;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.35rem;
    margin: 0;
    color: #142B44;
  }

  .about-card p {
    margin: 0 0 12px;
    line-height: 1.7;
    color: #142B44;
    font-size: 0.97rem;
  }

  .about-card p:last-child { margin-bottom: 0; }

  /* Steps */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: step;
  }

  .steps li {
    display: flex;
    gap: 0.85em;
    align-items: flex-start;
    padding: 10px 0;
    border-bottom: 1px solid #EAF3FB;
  }

  .steps li:last-child { border-bottom: none; padding-bottom: 0; }
  .steps li:first-child { padding-top: 0; }

  .step-num {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--grad);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }

  .steps li div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.5;
  }

  .steps li strong {
    font-size: 0.96rem;
    color: #142B44;
    font-weight: 700;
  }

  .steps li span {
    font-size: 0.9rem;
    color: #6B8099;
    font-weight: 500;
  }

  /* Promises */
  .promises, .rules {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .promises li {
    display: flex;
    align-items: flex-start;
    gap: 0.7em;
    padding: 8px 0;
    line-height: 1.55;
    font-size: 0.95rem;
    color: #142B44;
  }

  .promise-icon {
    color: #FFC72C;
    font-size: 1.15rem;
    flex-shrink: 0;
    margin-top: 0.15em;
  }

  /* Rules */
  .rules li {
    position: relative;
    padding: 8px 0 8px 1.4em;
    line-height: 1.55;
    font-size: 0.95rem;
    color: #142B44;
  }

  .rules li::before {
    content: '';
    position: absolute;
    left: 0.35em;
    top: 1.05em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #0054A6;
  }

  .footnote {
    margin-top: 12px !important;
    padding-top: 12px;
    border-top: 1px dashed #D5E3F2;
    font-size: 0.85rem !important;
    color: #6B8099 !important;
    font-style: italic;
  }

  /* Credits */
  .credits {
    margin-top: 26px;
    text-align: center;
  }

  .credit-line {
    margin: 0 0 8px;
    font-size: 0.88rem;
    color: #6B8099;
    font-weight: 500;
    line-height: 1.5;
  }

  .credit-line:last-child { margin-bottom: 0; }

  .credit-line strong {
    color: #0054A6;
    font-weight: 700;
  }

  .with-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    flex-wrap: wrap;
  }

  .astro-icon {
    width: 1.1em;
    height: 1.1em;
    display: inline-block;
  }
</style>
