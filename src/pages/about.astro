---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<Base title="About Me · SSU Freedom Wall">
  <div class="about-page">
    <a href="/" class="back-link">
      <Icon name="arrow-back" />
      <span>Back to the wall</span>
    </a>

    <header class="about-hero">
      <h1>
        <Icon name="sparkle" class="h1-icon" />
        About Me
        <Icon name="sparkle" class="h1-icon" />
      </h1>
      <p class="sub">Hi. I made this.</p>
    </header>

    <section class="about-card">
      <p>
        I'm a freshman from BINDTECH ELXT-1A. I built this wall because there's
        always stuff people can't say out loud. That's it.
      </p>
    </section>

    <section class="about-card video-card">
      <video
        class="about-video"
        src="/kalaindaw.mp4"
        controls
        playsinline
        preload="metadata"
      ></video>
    </section>

    <section class="about-card">
      <div class="section-header">
        <Icon name="pencil" class="section-icon" />
        <h2>How it works</h2>
      </div>
      <ol class="steps">
        <li>
          <span class="step-num">1</span>
          <div>
            <strong>Type it out.</strong>
            <span>Whatever's been sitting on your chest. Up to 5000 characters.</span>
          </div>
        </li>
        <li>
          <span class="step-num">2</span>
          <div>
            <strong>Check it.</strong>
            <span>You'll see how it looks before it goes anywhere.</span>
          </div>
        </li>
        <li>
          <span class="step-num">3</span>
          <div>
            <strong>Send it.</strong>
            <span>Done. Nobody knows it came from you.</span>
          </div>
        </li>
      </ol>
    </section>

    <section class="about-card">
      <div class="section-header">
        <Icon name="shield" class="section-icon" />
        <h2>What I won't do</h2>
      </div>
      <ul class="promises">
        <li>
          <Icon name="lock" class="promise-icon" />
          <span>I won't store anything about you. No names, no IPs, no device stuff. Only your words.</span>
        </li>
        <li>
          <Icon name="users" class="promise-icon" />
          <span>I won't play favorites. Every message gets read the same way.</span>
        </li>
        <li>
          <Icon name="heart" class="promise-icon" />
          <span>I won't let this turn into a place to hurt people. That's not what this is for.</span>
        </li>
      </ul>
    </section>

    <section class="about-card">
      <div class="section-header">
        <Icon name="leaf" class="section-icon" />
        <h2>The one rule</h2>
      </div>
      <p>
        Don't be a jerk. No names, no doxxing, no threats. That's it. Everything
        else, you're free.
      </p>
      <p class="footnote">If it breaks that rule, it doesn't go up. Simple.</p>
    </section>

    <div class="credits">
      <p class="credit-line">
        Made by a Freshman from <strong>BINDTECH ELXT-1A</strong>
      </p>
      <p class="credit-line with-icon">
        <span>Made with</span>
        <svg class="astro-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="url(#astroGrad)" d="M12 1.5l2.7 7.2 7.3 1.3-5.3 5.1 1.4 7.4L12 19l-6.1 3.5 1.4-7.4L2 10l7.3-1.3L12 1.5z"/>
          <defs>
            <linearGradient id="astroGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#0054A6"/>
              <stop offset="100%" stop-color="#FFC72C"/>
            </linearGradient>
          </defs>
        </svg>
        <span>Astro</span>
      </p>
    </div>

    <Footer />
  </div>
</Base>

<style>
  .about-page { width: 100%; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: 999px;
    transition: background 0.15s, color 0.15s;
  }
  .back-link:hover { background: var(--hover-bg); color: var(--accent); }
  .back-link :global(.icon) { font-size: 1.05em; }

  .about-hero { margin-bottom: 22px; }

  h1 {
    font-size: 2.4rem;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
  }

  :global(.h1-icon) {
    width: 0.55em;
    height: 0.55em;
    opacity: 0.85;
    flex-shrink: 0;
  }

  .sub { margin-bottom: 0; }

  .about-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px 22px;
    box-shadow: var(--shadow);
    margin-bottom: 14px;
    transition: background 0.3s, border-color 0.3s;
  }

  .video-card {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 14px;
  }

  .about-video {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: calc(var(--radius) - 8px);
    background: #000;
    outline: none;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 0.55em;
    margin-bottom: 14px;
  }

  .section-icon {
    font-size: 1.2rem;
    color: var(--accent);
    flex-shrink: 0;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.35rem;
    margin: 0;
    color: var(--text);
  }

  .about-card p {
    margin: 0 0 12px;
    line-height: 1.7;
    color: var(--text);
    font-size: 0.97rem;
  }

  .about-card p:last-child { margin-bottom: 0; }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .steps li {
    display: flex;
    gap: 0.85em;
    align-items: flex-start;
    padding: 10px 0;
    border-bottom: 1px solid var(--divider);
  }

  .steps li:last-child { border-bottom: none; padding-bottom: 0; }
  .steps li:first-child { padding-top: 0; }

  .step-num {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--grad);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }

  .steps li div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.5;
  }

  .steps li strong {
    font-size: 0.96rem;
    color: var(--text);
    font-weight: 700;
  }

  .steps li span {
    font-size: 0.9rem;
    color: var(--muted);
    font-weight: 500;
  }

  .promises {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .promises li {
    display: flex;
    align-items: flex-start;
    gap: 0.7em;
    padding: 8px 0;
    line-height: 1.55;
    font-size: 0.95rem;
    color: var(--text);
  }

  .promise-icon {
    color: var(--accent-2);
    font-size: 1.15rem;
    flex-shrink: 0;
    margin-top: 0.15em;
  }

  .footnote {
    margin-top: 14px !important;
    padding-top: 12px;
    border-top: 1px dashed var(--dashed);
    font-size: 0.88rem !important;
    color: var(--muted) !important;
    font-style: italic;
  }

  .credits {
    margin-top: 26px;
    text-align: center;
  }

  .credit-line {
    margin: 0 0 8px;
    font-size: 0.88rem;
    color: var(--muted);
    font-weight: 500;
    line-height: 1.5;
  }

  .credit-line:last-child { margin-bottom: 0; }

  .credit-line strong {
    color: var(--accent);
    font-weight: 700;
  }

  .with-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    flex-wrap: wrap;
  }

  .astro-icon {
    width: 1.1em;
    height: 1.1em;
    display: inline-block;
  }
</style>
