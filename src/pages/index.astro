---
import Base from '../layouts/Base.astro';
import SubmissionForm from '../components/SubmissionForm.astro';
import ConfirmModal from '../components/ConfirmModal.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<Base title="SSU Freedom Wall">
  <h1>
    <Icon name="sparkle" class="h1-icon" />
    SSU Freedom Wall
    <Icon name="sparkle" class="h1-icon" />
  </h1>
  <p class="sub">Your submissions are fully anonymous, so rest assured.</p>

  <SubmissionForm />
  <ConfirmModal />
  <Footer />

  <div class="toast" id="toast"></div>
</Base>

<style>
  h1 {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
  }
  :global(.h1-icon) {
    width: 0.55em;
    height: 0.55em;
    opacity: 0.85;
    flex-shrink: 0;
  }
</style>
