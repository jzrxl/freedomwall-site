---
import Base from '../layouts/Base.astro';
---

<Base title="Card Generator · SSU Freedom Wall" noindex={true}>
  <div class="make-page">
    <a href="/" class="back-link">← Back</a>
    <h1>Card Generator</h1>
    <p class="sub">Paste a message, download the image, post it.</p>

    <div class="card">
      <label for="msg">Message</label>
      <textarea
        id="msg"
        maxlength="5000"
        placeholder="Paste the submission here..."
      ></textarea>

      <div class="preview-wrap">
        <canvas id="canvas" width="1080" height="1080"></canvas>
      </div>

      <div class="actions">
        <button type="button" id="download" class="btn-primary">Download PNG</button>
        <button type="button" id="copy" class="btn-secondary">Copy caption</button>
      </div>
      <div id="status" class="status"></div>
    </div>
  </div>
</Base>

<style>
  .make-page { width: 100%; }

  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    transition: background 0.15s, color 0.15s;
  }
  .back-link:hover { background: var(--hover-bg); color: var(--accent); }

  h1 { font-size: 2rem; margin: 0 0 6px; text-align: center; }

  .sub {
    color: var(--muted);
    font-size: 0.92rem;
    text-align: center;
    margin: 0 0 22px;
  }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow);
  }

  label {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--text);
  }

  textarea {
    width: 100%;
    min-height: 120px;
    resize: vertical;
    padding: 14px;
    font-size: 1rem;
    line-height: 1.5;
    font-family: inherit;
    font-weight: 500;
    color: var(--text);
    background: var(--input-bg);
    border: 1.5px solid var(--border);
    border-radius: 14px;
    outline: none;
    transition: border-color 0.15s;
  }
  textarea:focus { border-color: var(--accent); }

  .preview-wrap {
    margin-top: 16px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #f0f0f0;
    display: flex;
    justify-content: center;
  }

  canvas {
    display: block;
    width: 100%;
    max-width: 360px;
    height: auto;
  }

  .actions { display: flex; gap: 10px; margin-top: 16px; }

  .actions button {
    flex: 1;
    padding: 14px;
    font-size: 0.98rem;
    font-weight: 700;
    font-family: inherit;
    border-radius: 14px;
    border: none;
    cursor: pointer;
    transition: opacity 0.15s, background 0.15s;
  }

  .btn-primary {
    background: var(--grad);
    color: #fff;
    box-shadow: 0 6px 16px rgba(0, 84, 166, 0.25);
  }
  .btn-primary:hover { opacity: 0.94; }

  .btn-secondary {
    background: transparent;
    color: var(--muted);
    border: 1.5px solid var(--border) !important;
  }
  .btn-secondary:hover { background: var(--hover-bg); color: var(--accent); }

  .status {
    margin-top: 12px;
    text-align: center;
    font-size: 0.85rem;
    color: var(--muted);
    min-height: 1em;
  }
</style>

<script>
  const canvas = document.getElementById('canvas') as HTMLCanvasElement;
  const msgInput = document.getElementById('msg') as HTMLTextAreaElement;
  const downloadBtn = document.getElementById('download') as HTMLButtonElement;
  const copyBtn = document.getElementById('copy') as HTMLButtonElement;
  const status = document.getElementById('status')!;

  let logo: HTMLImageElement | null = null;

  const W = 1080;
  const PAD_X = 100;
  const TOP_PAD = 140;
  const FOOTER_H = 260;
  const MIN_H = 1080;
  const MAX_H = 3000;

  function wrapText(c: CanvasRenderingContext2D, text: string, maxWidth: number): string[] {
    const out: string[] = [];
    for (const para of text.split('\n')) {
      if (para.trim() === '') { out.push(''); continue; }
      const words = para.split(/\s+/);
      let line = '';
      for (const word of words) {
        const test = line ? line + ' ' + word : word;
        if (c.measureText(test).width > maxWidth && line) {
          out.push(line);
          line = word;
        } else {
          line = test;
        }
      }
      if (line) out.push(line);
    }
    return out;
  }

  function draw() {
    const raw = msgInput.value.trim() || 'Your message will appear here.';

    const maxTextWidth = W - PAD_X * 2;
    let fontSize = 58;
    let lineHeight = 74;
    let lines: string[] = [];
    let textBlockH = 0;

    for (let size = 58; size >= 28; size -= 2) {
      fontSize = size;
      lineHeight = Math.round(size * 1.28);
      const m = document.createElement('canvas');
      const mctx = m.getContext('2d')!;
      mctx.font = `400 ${fontSize}px Fraunces`;
      lines = wrapText(mctx, raw, maxTextWidth);
      textBlockH = lines.length * lineHeight;
      const candidate = TOP_PAD + textBlockH + 60 + FOOTER_H;
      if (candidate <= MAX_H) break;
    }

    const contentH = textBlockH + 60;
    const H = Math.max(MIN_H, TOP_PAD + contentH + FOOTER_H);

    canvas.width = W;
    canvas.height = H;
    const ctx = canvas.getContext('2d')!;

    ctx.fillStyle = '#0A1828';
    ctx.fillRect(0, 0, W, H);

    const vignette = ctx.createRadialGradient(W/2, H/3, 100, W/2, H/2, Math.max(W, H));
    vignette.addColorStop(0, 'rgba(20, 43, 68, 0.6)');
    vignette.addColorStop(1, 'rgba(10, 24, 40, 0)');
    ctx.fillStyle = vignette;
    ctx.fillRect(0, 0, W, H);

    function sampleGradient(t: number) {
      const stops = [
        { t: 0, c: [92, 165, 224] },
        { t: 0.5, c: [123, 183, 230] },
        { t: 1, c: [255, 199, 44] },
      ];
      for (let i = 0; i < stops.length - 1; i++) {
        if (t >= stops[i].t && t <= stops[i + 1].t) {
          const local = (t - stops[i].t) / (stops[i + 1].t - stops[i].t);
          return {
            r: Math.round(stops[i].c[0] + (stops[i + 1].c[0] - stops[i].c[0]) * local),
            g: Math.round(stops[i].c[1] + (stops[i + 1].c[1] - stops[i].c[1]) * local),
            b: Math.round(stops[i].c[2] + (stops[i + 1].c[2] - stops[i].c[2]) * local),
          };
        }
      }
      return { r: 92, g: 165, b: 224 };
    }

    const particles = 2600;
    for (let i = 0; i < particles; i++) {
      const t = Math.random();
      const diagX = t * (W + H);
      const diagY = diagX;
      const r = (Math.random() + Math.random() + Math.random() - 1.5) * 220;
      const angle = Math.PI / 4;
      const perpX = -Math.sin(angle);
      const perpY = Math.cos(angle);
      const x = diagX + perpX * r;
      const y = diagY + perpY * r;
      if (x < -50 || x > W + 50 || y < -50 || y > H + 50) continue;
      const colorT = Math.max(0, Math.min(1, (x + y) / (W + H)));
      const c = sampleGradient(colorT);
      const edge = Math.abs(r) / 220;
      const size = Math.max(0.5, 2.5 * (1 - edge * 0.6) * (0.4 + Math.random() * 0.8));
      const alpha = Math.max(0.05, (1 - edge) * (0.3 + Math.random() * 0.5));
      ctx.fillStyle = `rgba(${c.r}, ${c.g}, ${c.b}, ${alpha})`;
      ctx.beginPath();
      ctx.arc(x, y, size, 0, Math.PI * 2);
      ctx.fill();
    }

    const contentTop = TOP_PAD;
    const contentBottom = TOP_PAD + contentH;
    const contentMidY = (contentTop + contentBottom) / 2;
    const bodyStartY = contentMidY - textBlockH / 2 + lineHeight / 2;

    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.font = `400 ${fontSize}px Fraunces`;
    ctx.fillStyle = '#F1F4F8';
    ctx.shadowColor = 'rgba(0, 0, 0, 0.45)';
    ctx.shadowBlur = 12;
    lines.forEach((line, i) => {
      ctx.fillText(line, W / 2, bodyStartY + i * lineHeight);
    });
    ctx.shadowColor = 'transparent';
    ctx.shadowBlur = 0;

    const footerCy = H - FOOTER_H / 2;
    if (logo) {
      const logoMaxW = 380;
      const logoMaxH = 100;
      const ratio = logo.width / logo.height;
      let lw = logoMaxW;
      let lh = lw / ratio;
      if (lh > logoMaxH) { lh = logoMaxH; lw = lh * ratio; }
      ctx.drawImage(logo, (W - lw) / 2, footerCy - lh / 2, lw, lh);
    } else {
      ctx.font = '400 46px Caprasimo';
      ctx.fillStyle = '#FFC72C';
      ctx.fillText('SSU Freedom Wall', W / 2, footerCy);
    }
  }

  async function ready() {
    try {
      await Promise.all([
        document.fonts.load('400 58px Fraunces'),
        document.fonts.load('400 28px Fraunces'),
      ]);
      await document.fonts.ready;
    } catch (e) {}

    logo = await new Promise<HTMLImageElement | null>((resolve) => {
      const img = new Image();
      img.onload = () => resolve(img);
      img.onerror = () => resolve(null);
      img.src = '/logo-mark.png';
    });

    draw();
  }

  msgInput?.addEventListener('input', draw);

  downloadBtn?.addEventListener('click', () => {
    canvas.toBlob((blob) => {
      if (!blob) return;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `ssu-wall-${Date.now()}.png`;
      a.click();
      URL.revokeObjectURL(url);
      status.textContent = 'Downloaded.';
      setTimeout(() => status.textContent = '', 2000);
    }, 'image/png');
  });

  copyBtn?.addEventListener('click', async () => {
    const msg = msgInput.value.trim();
    if (!msg) { status.textContent = 'Nothing to copy.'; return; }
    const caption = `#SSUFreedomWall\n\n${msg}`;
    try {
      await navigator.clipboard.writeText(caption);
      status.textContent = 'Caption copied.';
    } catch {
      status.textContent = 'Copy failed — select manually.';
    }
    setTimeout(() => status.textContent = '', 2500);
  });

  ready();
</script>
