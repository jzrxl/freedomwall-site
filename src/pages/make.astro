---
import Base from '../layouts/Base.astro';
---

<Base title="Card Generator · SSU Freedom Wall">
  <div class="make-page">
    <a href="/" class="back-link">← Back</a>
    <h1>Card Generator</h1>
    <p class="sub">Paste a message, download the image, post it.</p>

    <div class="card">
      <label for="msg">Message</label>
      <textarea
        id="msg"
        maxlength="5000"
        placeholder="Paste the submission here..."
      ></textarea>

      <div class="preview-wrap">
        <canvas id="canvas" width="1080" height="1350"></canvas>
      </div>

      <div class="actions">
        <button type="button" id="download" class="btn-primary">Download PNG</button>
        <button type="button" id="copy" class="btn-secondary">Copy caption</button>
      </div>
      <div id="status" class="status"></div>
    </div>
  </div>
</Base>

<style>
  .make-page { width: 100%; }

  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    transition: background 0.15s, color 0.15s;
  }
  .back-link:hover { background: var(--hover-bg); color: var(--accent); }

  h1 { font-size: 2rem; margin: 0 0 6px; text-align: center; }

  .sub {
    color: var(--muted);
    font-size: 0.92rem;
    text-align: center;
    margin: 0 0 22px;
  }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow);
  }

  label {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--text);
  }

  textarea {
    width: 100%;
    min-height: 120px;
    resize: vertical;
    padding: 14px;
    font-size: 1rem;
    line-height: 1.5;
    font-family: inherit;
    font-weight: 500;
    color: var(--text);
    background: var(--input-bg);
    border: 1.5px solid var(--border);
    border-radius: 14px;
    outline: none;
    transition: border-color 0.15s;
  }
  textarea:focus { border-color: var(--accent); }

  .preview-wrap {
    margin-top: 16px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #f0f0f0;
    display: flex;
    justify-content: center;
  }

  canvas {
    display: block;
    width: 100%;
    max-width: 360px;
    height: auto;
  }

  .actions { display: flex; gap: 10px; margin-top: 16px; }

  .actions button {
    flex: 1;
    padding: 14px;
    font-size: 0.98rem;
    font-weight: 700;
    font-family: inherit;
    border-radius: 14px;
    border: none;
    cursor: pointer;
    transition: opacity 0.15s, background 0.15s;
  }

  .btn-primary {
    background: var(--grad);
    color: #fff;
    box-shadow: 0 6px 16px rgba(0, 84, 166, 0.25);
  }
  .btn-primary:hover { opacity: 0.94; }

  .btn-secondary {
    background: transparent;
    color: var(--muted);
    border: 1.5px solid var(--border) !important;
  }
  .btn-secondary:hover { background: var(--hover-bg); color: var(--accent); }

  .status {
    margin-top: 12px;
    text-align: center;
    font-size: 0.85rem;
    color: var(--muted);
    min-height: 1em;
  }
</style>

<script>
  const canvas = document.getElementById('canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const msgInput = document.getElementById('msg') as HTMLTextAreaElement;
  const downloadBtn = document.getElementById('download') as HTMLButtonElement;
  const copyBtn = document.getElementById('copy') as HTMLButtonElement;
  const status = document.getElementById('status')!;

  const W = 1080;
  const PAD_X = 90;
  const MIN_H = 1350;
  const HEADER_H = 180;
  const FOOTER_H = 200;
  const BODY_PAD = 60;
  const MAX_H = 3000;

  function wrapText(text: string, maxWidth: number): string[] {
    const lines: string[] = [];
    for (const paragraph of text.split('\n')) {
      if (paragraph.trim() === '') { lines.push(''); continue; }
      const words = paragraph.split(/\s+/);
      let line = '';
      for (const word of words) {
        const test = line ? line + ' ' + word : word;
        if (ctx.measureText(test).width > maxWidth && line) {
          lines.push(line);
          line = word;
        } else {
          line = test;
        }
      }
      if (line) lines.push(line);
    }
    return lines;
  }

  function draw() {
    const msg = msgInput.value.trim() || 'Your message will appear here.';
    const maxTextWidth = W - PAD_X * 2 - 40;

    // Try font sizes from large to small until it fits under MAX_H
    let fontSize = 46;
    let lineHeight = 70;
    let lines: string[] = [];
    let bodyHeight = 0;

    for (let size = 46; size >= 30; size -= 2) {
      fontSize = size;
      lineHeight = Math.round(size * 1.5);
      ctx.font = `500 ${fontSize}px Quicksand`;
      lines = wrapText(msg, maxTextWidth);
      bodyHeight = lines.length * lineHeight;
      if (HEADER_H + BODY_PAD + bodyHeight + BODY_PAD + FOOTER_H <= MAX_H) break;
    }

    const computedH = HEADER_H + BODY_PAD + bodyHeight + BODY_PAD + FOOTER_H;
    const H = Math.max(MIN_H, computedH);

    canvas.height = H;

    // Background
    const grad = ctx.createLinearGradient(0, 0, W, H);
    grad.addColorStop(0, '#EAF3FB');
    grad.addColorStop(1, '#FFF6DE');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    // Top wordmark with dot
    ctx.textAlign = 'left';
    ctx.textBaseline = 'top';
    ctx.fillStyle = '#0054A6';
    ctx.beginPath();
    ctx.arc(PAD_X + 5, 82, 5, 0, Math.PI * 2);
    ctx.fill();
    ctx.font = '600 24px Quicksand';
    ctx.fillStyle = '#6B8099';
    ctx.fillText('ssu freedom wall', PAD_X + 24, 70);

    // Left accent bar
    const barX = PAD_X - 26;
    const barY = HEADER_H + BODY_PAD - 6;
    ctx.fillStyle = '#0054A6';
    ctx.fillRect(barX, barY, 5, bodyHeight + 12);

    // Body text
    ctx.font = `500 ${fontSize}px Quicksand`;
    ctx.fillStyle = '#142B44';
    const bodyStartY = HEADER_H + BODY_PAD;
    lines.forEach((line, i) => {
      ctx.fillText(line, PAD_X, bodyStartY + i * lineHeight);
    });

    // Divider
    const footerTop = H - FOOTER_H + 40;
    ctx.strokeStyle = 'rgba(20, 43, 68, 0.12)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(PAD_X, footerTop);
    ctx.lineTo(W - PAD_X, footerTop);
    ctx.stroke();

    // Footer right
    ctx.textAlign = 'right';
    ctx.font = '600 22px Quicksand';
    ctx.fillStyle = '#0054A6';
    ctx.fillText('SSU Freedom Wall', W - PAD_X, footerTop + 46);
  }

  async function ready() {
    try {
      await Promise.all([
        document.fonts.load('600 24px Quicksand'),
        document.fonts.load('500 46px Quicksand'),
        document.fonts.load('500 30px Quicksand'),
        document.fonts.load('600 22px Quicksand'),
      ]);
    } catch (e) {}
    draw();
  }

  msgInput?.addEventListener('input', draw);

  downloadBtn?.addEventListener('click', () => {
    canvas.toBlob((blob) => {
      if (!blob) return;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `ssu-wall-${Date.now()}.png`;
      a.click();
      URL.revokeObjectURL(url);
      status.textContent = 'Downloaded.';
      setTimeout(() => status.textContent = '', 2000);
    }, 'image/png');
  });

  copyBtn?.addEventListener('click', async () => {
    const msg = msgInput.value.trim();
    if (!msg) { status.textContent = 'Nothing to copy.'; return; }
    const caption = `#SSUFreedomWall\n\n${msg}`;
    try {
      await navigator.clipboard.writeText(caption);
      status.textContent = 'Caption copied.';
    } catch {
      status.textContent = 'Copy failed — select manually.';
    }
    setTimeout(() => status.textContent = '', 2500);
  });

  ready();
</script>
