---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Your submissions are fully anonymous, so rest assured." />

  <!-- Force light mode, resist dark-mode overrides -->
  <meta name="color-scheme" content="only light" />
  <meta name="supported-color-schemes" content="only light" />
  <meta name="theme-color" content="#fff0f5" />
  <!-- Dark Reader opt-out -->
  <meta name="darkreader-lock" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caprasimo&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body>
  <main class="wrap">
    <slot />
  </main>
</body>
</html>
