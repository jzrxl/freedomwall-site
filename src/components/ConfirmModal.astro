---
import Icon from './Icon.astro';
---

<div class="overlay" id="overlay">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
    <h2 id="confirmTitle">Send this message?</h2>
    <p class="hint">Once it's sent, it can't be edited.</p>

    <div class="actions">
      <button type="button" class="cancel" id="cancelBtn">
        <Icon name="arrow-back" />
        <span>Keep editing</span>
      </button>
      <button type="button" class="confirm" id="confirmBtn">
        <Icon name="send" />
        <span>Yes, send it</span>
      </button>
    </div>
  </div>
</div>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    background: var(--overlay);
    backdrop-filter: blur(6px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 10;
  }
  .overlay.open { display: flex; }

  .modal {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    max-width: 420px;
    width: 100%;
    padding: 26px 22px;
    box-shadow: var(--shadow);
    transition: background 0.3s, border-color 0.3s;
    text-align: center;
    outline: none;
  }

  .modal h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    margin: 0 0 8px;
    color: var(--text);
  }

  .hint {
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .actions { display: flex; gap: 10px; }

  .actions button {
    flex: 1;
    padding: 13px;
    font-size: 0.98rem;
    font-weight: 700;
    font-family: inherit;
    border-radius: 14px;
    border: none;
    cursor: pointer;
    transition: background 0.15s, opacity 0.15s, color 0.3s, border-color 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45em;
  }

  .cancel {
    background: transparent;
    color: var(--muted);
    border: 1.5px solid var(--border);
  }
  .cancel:hover { background: var(--hover-bg); color: var(--text); }

  .confirm {
    background: var(--grad);
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(0, 84, 166, 0.3);
  }
  .confirm:hover { opacity: 0.94; }
</style>

<script>
  const overlay = document.getElementById('overlay')!;
  const cancelBtn = document.getElementById('cancelBtn') as HTMLButtonElement;
  const confirmBtn = document.getElementById('confirmBtn') as HTMLButtonElement;
  const toast = document.getElementById('toast')!;
  const form = document.getElementById('form') as HTMLFormElement;
  const counter = document.getElementById('counter')!;
  const message = document.getElementById('message') as HTMLTextAreaElement | null;
  const asImage = document.getElementById('asImage') as HTMLInputElement | null;

  let trapHandler: ((e: KeyboardEvent) => void) | null = null;

  function installFocusTrap() {
    const focusables = [cancelBtn, confirmBtn];
    cancelBtn.focus();
    trapHandler = (e: KeyboardEvent) => {
      if (e.key === 'Tab') {
        const idx = focusables.indexOf(document.activeElement as HTMLButtonElement);
        e.preventDefault();
        const next = e.shiftKey
          ? (idx <= 0 ? focusables.length - 1 : idx - 1)
          : (idx >= focusables.length - 1 || idx === -1 ? 0 : idx + 1);
        focusables[next].focus();
      }
    };
    document.addEventListener('keydown', trapHandler, true);
  }

  function removeFocusTrap() {
    if (trapHandler) {
      document.removeEventListener('keydown', trapHandler, true);
      trapHandler = null;
    }
  }

  function close() {
    overlay.classList.remove('open');
    removeFocusTrap();
    message?.focus();
  }

  function showToast(text: string) {
    toast.textContent = text;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3000);
  }

  window.addEventListener('confirm-open', () => installFocusTrap());

  cancelBtn?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('open')) close();
  });

  confirmBtn?.addEventListener('click', async () => {
    confirmBtn.disabled = true;
    confirmBtn.innerHTML = '<span>Sending...</span>';

    const finalText = (window as any).__finalText || '';
    const finalImage = (window as any).__finalImage as string | null;

    const params = new URLSearchParams({ message: finalText });
    if (finalImage) {
      params.set('imageBase64', finalImage);
    }

    try {
      const res = await fetch('/api/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params,
      });
      if (!res.ok) throw new Error();

      overlay.classList.remove('open');
      removeFocusTrap();
      form?.reset();
      if (asImage) asImage.checked = false;
      counter.textContent = '0 / 5000';
      counter.parentElement?.classList.remove('count-warn', 'count-danger');
      try { localStorage.removeItem('fw_draft'); } catch (e) {}
      (window as any).__finalImage = null;
      showToast('Sent. Thank you for sharing.');
    } catch {
      showToast('Something went wrong. Please try again.');
    } finally {
      confirmBtn.disabled = false;
      confirmBtn.innerHTML = '<svg class="icon" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg><span>Yes, send it</span>';
    }
  });
</script>
