---
import Icon from './Icon.astro';
---

<div class="overlay" id="overlay">
  <div class="modal" role="dialog" aria-modal="true">
    <h2>Send this message?</h2>
    <p class="hint">Here's what will be saved.</p>

    <div class="preview-container">
      <div id="textPreviewWrap" class="preview-block" hidden>
        <div class="preview-label">Text preview:</div>
        <div class="preview-text" id="previewText"></div>
      </div>

      <div id="imagePreviewWrap" class="preview-block" hidden>
        <div class="preview-label">Image preview:</div>
        <img id="previewImage" class="preview-img" alt="Uploaded preview" />
      </div>
    </div>

    <div class="actions">
      <button type="button" class="cancel" id="cancelBtn">
        <Icon name="arrow-back" />
        <span>Go back</span>
      </button>
      <button type="button" class="confirm" id="confirmBtn">
        <Icon name="send" />
        <span>Yes, send it</span>
      </button>
    </div>
  </div>
</div>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    background: var(--overlay);
    backdrop-filter: blur(6px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 10;
  }
  .overlay.open { display: flex; }

  .modal {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    max-width: 460px;
    width: 100%;
    padding: 26px 22px;
    box-shadow: var(--shadow);
    text-align: center;
  }

  .modal h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    margin: 0 0 6px;
    color: var(--text);
  }
  .hint {
    margin: 0 0 18px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .preview-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
  }

  .preview-block {
    background: var(--input-bg);
    border: 1.5px solid var(--border);
    border-radius: 14px;
    padding: 14px;
    overflow: hidden;
  }

  .preview-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
    letter-spacing: 0.05em;
  }

  .preview-text {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text);
    white-space: pre-wrap;
    word-wrap: break-word;
    max-height: 140px;
    overflow-y: auto;
  }

  .preview-img {
    display: block;
    width: 100%;
    max-height: 260px;
    object-fit: contain;
    border-radius: 8px;
    background: #000;
  }

  .actions { display: flex; gap: 10px; margin-top: 22px; }
  .actions button {
    flex: 1;
    padding: 13px;
    font-size: 0.98rem;
    font-weight: 700;
    border-radius: 14px;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45em;
  }
  .cancel { background: transparent; color: var(--muted); border: 1.5px solid var(--border); }
  .confirm { background: var(--grad); color: #ffffff; }
</style>

<script>
  const overlay = document.getElementById('overlay')!;
  const cancelBtn = document.getElementById('cancelBtn')!;
  const confirmBtn = document.getElementById('confirmBtn') as HTMLButtonElement;
  const toast = document.getElementById('toast')!;
  const form = document.getElementById('form') as HTMLFormElement;
  
  const textPreviewWrap = document.getElementById('textPreviewWrap')!;
  const previewText = document.getElementById('previewText')!;
  const imagePreviewWrap = document.getElementById('imagePreviewWrap')!;
  const previewImage = document.getElementById('previewImage') as HTMLImageElement;

  function close() { overlay.classList.remove('open'); }

  window.addEventListener('confirm-open', () => {
    const text = (window as any).__finalText || '';
    const imgB64 = (window as any).__finalImage;

    if (text) {
      previewText.textContent = text;
      textPreviewWrap.hidden = false;
    } else {
      textPreviewWrap.hidden = true;
    }

    if (imgB64) {
      previewImage.src = `data:image/jpeg;base64,${imgB64}`; // Assume jpeg for preview rendering
      imagePreviewWrap.hidden = false;
    } else {
      imagePreviewWrap.hidden = true;
    }
  });

  cancelBtn?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('open')) close();
  });

  confirmBtn?.addEventListener('click', async () => {
    confirmBtn.disabled = true;
    confirmBtn.innerHTML = '<span>Sending...</span>';

    const finalText = (window as any).__finalText || '';
    const finalImage = (window as any).__finalImage;
    const finalExt = (window as any).__finalImageExt;

    const params = new URLSearchParams({ message: finalText });
    if (finalImage) {
      params.set('imageBase64', finalImage);
      params.set('imageExt', finalExt);
    }

    try {
      const res = await fetch('/api/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params,
      });
      if (!res.ok) throw new Error();

      close();
      form?.reset();
      document.getElementById('removeImg')?.click();
      toast.textContent = 'Sent. Thank you for sharing.';
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3000);
    } catch {
      toast.textContent = 'Something went wrong.';
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3000);
    } finally {
      confirmBtn.disabled = false;
      confirmBtn.innerHTML = '<span>Yes, send it</span>';
    }
  });
</script>
