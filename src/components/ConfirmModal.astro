---
---

<div class="overlay" id="overlay">
  <div class="modal">
    <h2>Send this message?</h2>
    <p class="hint">This is how it'll appear on the wall. Take one last look.</p>
    <div class="preview" id="preview"></div>
    <div class="actions">
      <button type="button" class="cancel" id="cancelBtn">Go back</button>
      <button type="button" class="confirm" id="confirmBtn">Yes, send it</button>
    </div>
  </div>
</div>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    z-index: 10;
  }

  .overlay.open { display: flex; }

  .modal {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    max-width: 560px;
    width: 100%;
    padding: 28px;
  }

  .modal h2 { margin: 0 0 4px; font-size: 1.25rem; }

  .hint { margin: 0 0 18px; color: var(--muted); font-size: 0.9rem; }

  .preview {
    background: #0f1115;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px;
    font-size: 1rem;
    line-height: 1.55;
    white-space: pre-wrap;
    word-wrap: break-word;
    max-height: 260px;
    overflow-y: auto;
  }

  .actions { display: flex; gap: 10px; margin-top: 22px; }

  .actions button {
    flex: 1;
    padding: 13px;
    font-size: 0.98rem;
    font-weight: 600;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    transition: background 0.15s;
  }

  .cancel {
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--border);
  }

  .cancel:hover { background: #1f232c; color: var(--text); }

  .confirm { background: var(--accent); color: #0b0d11; }
  .confirm:hover { background: var(--accent-hover); }
</style>

<script>
  const overlay = document.getElementById('overlay')!;
  const cancelBtn = document.getElementById('cancelBtn')!;
  const confirmBtn = document.getElementById('confirmBtn') as HTMLButtonElement;
  const toast = document.getElementById('toast')!;
  const form = document.getElementById('form') as HTMLFormElement;
  const counter = document.getElementById('counter')!;

  function close() { overlay.classList.remove('open'); }

  function showToast(text: string) {
    toast.textContent = text;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3000);
  }

  cancelBtn?.addEventListener('click', close);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('open')) close();
  });

  confirmBtn?.addEventListener('click', async () => {
    confirmBtn.disabled = true;
    confirmBtn.textContent = 'Sending...';

    const finalText = (window as any).__finalText || '';

    try {
      const res = await fetch('/api/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ message: finalText }),
      });

      if (!res.ok) throw new Error();

      close();
      form?.reset();
      counter.textContent = '0 / 2000';
      showToast('Sent. Thank you for sharing.');
    } catch {
      showToast('Something went wrong. Please try again.');
    } finally {
      confirmBtn.disabled = false;
      confirmBtn.textContent = 'Yes, send it';
    }
  });
</script>
