---
---

<footer class="site-footer">
  <div class="fb-wrap">
    <span class="fb-hint">check<br>submissions here</span>

    <svg class="fb-arrow" viewBox="0 0 200 100" fill="none" aria-hidden="true">
      <path
        d="M 178 28 Q 110 0, 30 78"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-dasharray="4 5"
        opacity="0.7"
      />
      <path
        d="M 52 68 L 26 80 L 44 92"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
        opacity="0.7"
      />
    </svg>

    <a
      href="https://www.facebook.com/freedomwallssu"
      class="fb-icon-btn"
      target="_blank"
      rel="noopener"
      aria-label="SSU Freedom Wall on Facebook"
      title="See what gets posted"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.5-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94z"/>
      </svg>
    </a>
  </div>

  <a href="/about" class="about-link">About Me</a>
</footer>

<style>
  .site-footer {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .fb-wrap {
    position: relative;
    width: 240px;
    height: 160px;
    margin: 0 auto;
  }

  .fb-hint {
    position: absolute;
    top: 0;
    right: 6px;
    transform: rotate(-7deg);
    transform-origin: top right;
    text-align: right;
    line-height: 1.2;
    font-family: 'Fraunces', Georgia, serif;
    font-style: italic;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--muted);
    opacity: 0.9;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .fb-arrow {
    position: absolute;
    top: 34px;
    left: 10px;
    width: 200px;
    height: 100px;
    color: var(--muted);
    pointer-events: none;
  }

  .fb-icon-btn {
    position: absolute;
    bottom: 0;
    left: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.12s;
  }

  .fb-icon-btn svg {
    width: 19px;
    height: 19px;
    display: block;
  }

  .fb-icon-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--hover-bg);
    transform: translateY(-1px);
  }

  .fb-icon-btn:active {
    transform: translateY(0) scale(0.94);
  }

  .about-link {
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--footer-link);
    text-decoration: none;
    opacity: 1;
    transition: color 0.2s, background 0.2s;
    letter-spacing: 0.04em;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card);
  }

  .about-link:hover {
    color: var(--accent);
    background: var(--hover-bg);
  }

  @media (max-width: 360px) {
    .fb-wrap { width: 200px; height: 140px; }
    .fb-arrow { width: 170px; height: 85px; top: 30px; }
    .fb-hint { font-size: 0.82rem; }
    .fb-icon-btn { width: 38px; height: 38px; }
  }
</style>
