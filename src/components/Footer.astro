---
---

<footer class="site-footer">
  <a
    href="https://www.facebook.com/freedomwallssu"
    class="fb-icon-btn"
    target="_blank"
    rel="noopener"
    aria-label="SSU Freedom Wall on Facebook"
    title="See what gets posted"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.5-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94z"/>
    </svg>
  </a>

  <a href="/about" class="about-link">About Me</a>
</footer>

<style>
  .site-footer {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .fb-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.12s;
  }

  .fb-icon-btn svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  .fb-icon-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--hover-bg);
    transform: translateY(-1px);
  }

  .fb-icon-btn:active {
    transform: translateY(0) scale(0.94);
  }

  .about-link {
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--footer-link);
    text-decoration: none;
    opacity: 1;
    transition: color 0.2s, background 0.2s;
    letter-spacing: 0.04em;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card);
  }

  .about-link:hover {
    color: var(--accent);
    background: var(--hover-bg);
  }
</style>
