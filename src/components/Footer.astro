---
---

<footer class="site-footer">
  <div class="footer-row">
    <a href="/about" class="footer-link">About Me</a>
    <span class="footer-sep">·</span>
    <a
      href="https://www.facebook.com/freedomwallssu"
      class="footer-link fb-link"
      target="_blank"
      rel="noopener"
    >
      <svg class="fb-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/>
      </svg>
      <span>Facebook</span>
    </a>
    <span class="faint-note">— see what gets posted</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 28px;
    text-align: center;
  }

  .footer-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    flex-wrap: wrap;
    justify-content: center;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card);
    font-size: 0.88rem;
    font-weight: 600;
    max-width: 100%;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--footer-link);
    text-decoration: none;
    transition: color 0.2s;
    letter-spacing: 0.03em;
  }

  .footer-link:hover { color: var(--accent); }

  .footer-sep {
    color: var(--border);
    opacity: 0.7;
  }

  .fb-icon {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
    color: #1877F2;
  }

  .fb-link:hover .fb-icon {
    color: var(--accent);
  }

  .faint-note {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.82rem;
    opacity: 0.75;
    font-style: italic;
  }

  @media (max-width: 420px) {
    .footer-row {
      border-radius: 16px;
      padding: 10px 14px;
      gap: 0.4em;
    }
    .faint-note {
      flex-basis: 100%;
      text-align: center;
      margin-top: 2px;
    }
  }
</style>
