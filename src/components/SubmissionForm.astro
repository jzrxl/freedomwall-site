---
import Icon from './Icon.astro';
---

<form id="form">
  <div class="card">
    <div class="row">
      <label for="audience">From / To <span class="hint">(College or Program)</span></label>
      <input type="text" id="audience" maxlength="80" placeholder="e.g. CCS, BSIT, College of Engineering" required />
    </div>

    <div class="row">
      <label for="message">Your message</label>
      <textarea id="message" maxlength="500" placeholder="Share your thoughts, your name won't be shown." required></textarea>
      <div class="meta">
        <span>Nothing is stored except your words.</span>
        <span id="counter">0 / 500</span>
      </div>
    </div>

    <div class="row">
      <label for="sender">From <span class="hint">(desired name or moniker)</span></label>
      <input type="text" id="sender" maxlength="40" placeholder="Anonymous" />
    </div>

    <button class="btn" type="submit">
      <Icon name="send" />
      <span>Preview &amp; send</span>
    </button>
  </div>
</form>

<style>
  .row { margin-bottom: 18px; }
  label { display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 8px; }
  .hint { font-weight: 500; color: var(--muted); font-size: 0.82rem; }

  input[type="text"] {
    width: 100%;
    padding: 14px 16px;
    font-size: 1rem;
    font-family: inherit;
    font-weight: 500;
    color: var(--text);
    background: #fffafc;
    border: 1.5px solid var(--border);
    border-radius: 14px;
    outline: none;
    transition: border-color 0.15s, background 0.15s;
  }
  input[type="text"]:focus { border-color: var(--accent); background: #fff; }
  input[type="text"]::placeholder { color: #c9b3bd; }

  textarea {
    width: 100%;
    min-height: 200px;
    resize: vertical;
    padding: 16px;
    font-size: 1.02rem;
    line-height: 1.6;
    font-family: inherit;
    font-weight: 500;
    color: var(--text);
    background: #fffafc;
    border: 1.5px solid var(--border);
    border-radius: 16px;
    outline: none;
    transition: border-color 0.15s, background 0.15s;
  }
  textarea:focus { border-color: var(--accent); background: #fff; }
  textarea::placeholder { color: #c9b3bd; }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    font-size: 0.83rem;
    font-weight: 500;
    color: var(--muted);
  }

  .btn {
    margin-top: 8px;
    width: 100%;
    padding: 16px;
    font-size: 1.05rem;
    font-weight: 700;
    font-family: inherit;
    color: #fff;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: transform 0.08s, box-shadow 0.15s;
    box-shadow: 0 8px 22px rgba(236, 72, 153, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
  }
  .btn:hover { box-shadow: 0 10px 28px rgba(236, 72, 153, 0.36); }
  .btn:active { transform: scale(0.98); }
</style>

<script>
  const form = document.getElementById('form') as HTMLFormElement;
  const message = document.getElementById('message') as HTMLTextAreaElement;
  const audience = document.getElementById('audience') as HTMLInputElement;
  const sender = document.getElementById('sender') as HTMLInputElement;
  const counter = document.getElementById('counter')!;

  message?.addEventListener('input', () => {
    counter.textContent = `${message.value.length} / 500`;
  });

  function buildFinalText(): string {
    const aud = audience.value.trim() || 'Everyone';
    const msg = message.value.trim();
    const from = sender.value.trim() || 'Anonymous';
    return `From/To [${aud}]:\n\n${msg}\n\n[From (Desired name or moniker)]: ${from}`;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    (window as any).__finalText = buildFinalText();
    const preview = document.getElementById('preview');
    if (preview) preview.textContent = (window as any).__finalText;
    document.getElementById('overlay')?.classList.add('open');
  });
</script>
