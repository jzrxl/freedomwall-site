---
import Icon from './Icon.astro';
---

<form id="form">
  <div class="card">
    <textarea
      id="message"
      maxlength="5000"
      placeholder="Share your thoughts, your name won't be shown."
      required
    ></textarea>

    <label class="image-option">
      <input type="checkbox" id="asImage" />
      <span>Send as image instead of text</span>
    </label>

    <div class="image-note" id="imageNote" hidden>
      <span id="imageNoteText">Best up to 800 characters (0 / 800)</span>
    </div>

    <div class="meta">
      <span id="counter">0 / 5000</span>
    </div>

    <button class="btn" type="submit">
      <Icon name="send" />
      <span id="btnLabel">Send</span>
    </button>
    <p class="shortcut-hint">Tip: press Ctrl + Enter to send</p>
  </div>
</form>

<style>
  textarea {
    width: 100%;
    min-height: 240px;
    resize: vertical;
    padding: 18px;
    font-size: 1.05rem;
    line-height: 1.6;
    font-family: inherit;
    font-weight: 500;
    color: var(--text);
    background: var(--input-bg);
    border: 1.5px solid var(--border);
    border-radius: 16px;
    outline: none;
    transition: border-color 0.15s, background 0.3s, color 0.3s;
    display: block;
  }
  textarea:focus { border-color: var(--accent); background: var(--card); }
  textarea::placeholder { color: var(--placeholder); }

  .image-option {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    user-select: none;
    padding: 4px 0;
  }
  .image-option input[type="checkbox"] {
    width: 15px;
    height: 15px;
    accent-color: var(--accent);
    cursor: pointer;
    flex-shrink: 0;
  }
  .image-option:hover { color: var(--text); }

  .image-note {
    margin: 2px 0 0 23px;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.15s;
  }
  .image-note.over {
    color: #dc2626;
    font-weight: 600;
  }
  [data-theme="dark"] .image-note.over { color: #f87171; }

  .meta {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-top: 6px;
    font-size: 0.83rem;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.2s;
  }
  .meta.count-warn #counter { color: #d97706; font-weight: 700; }
  .meta.count-danger #counter { color: #dc2626; font-weight: 700; }
  [data-theme="dark"] .meta.count-warn #counter { color: #fbbf24; }
  [data-theme="dark"] .meta.count-danger #counter { color: #f87171; }

  .btn {
    margin-top: 16px;
    width: 100%;
    padding: 16px;
    font-size: 1.05rem;
    font-weight: 700;
    font-family: inherit;
    color: #ffffff;
    background: var(--grad);
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: transform 0.08s, box-shadow 0.15s, opacity 0.15s;
    box-shadow: 0 8px 22px rgba(0, 84, 166, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
  }
  .btn:hover { box-shadow: 0 10px 28px rgba(0, 84, 166, 0.36); opacity: 0.96; }
  .btn:active { transform: scale(0.98); }

  .shortcut-hint {
    margin: 10px 0 0;
    text-align: center;
    font-size: 0.76rem;
    color: var(--muted);
    opacity: 0.75;
  }
  @media (max-width: 640px) { .shortcut-hint { display: none; } }
</style>

<script>
  const DRAFT_KEY = 'fw_draft';
  const MAX = 5000;
  const IMAGE_MAX = 800;
  const WARN_AT = 4500;
  const DANGER_AT = 4900;

  const form = document.getElementById('form') as HTMLFormElement;
  const message = document.getElementById('message') as HTMLTextAreaElement;
  const counter = document.getElementById('counter')!;
  const meta = counter.parentElement!;
  const asImage = document.getElementById('asImage') as HTMLInputElement;
  const imageNote = document.getElementById('imageNote')!;
  const imageNoteText = document.getElementById('imageNoteText')!;
  const btnLabel = document.getElementById('btnLabel')!;

  function updateCounter() {
    const len = message.value.length;
    counter.textContent = `${len} / ${MAX}`;
    meta.classList.toggle('count-warn', len >= WARN_AT && len < DANGER_AT);
    meta.classList.toggle('count-danger', len >= DANGER_AT);
  }

  function updateImageNote() {
    const checked = asImage.checked;
    const len = message.value.length;
    imageNote.hidden = !checked;
    if (!checked) {
      imageNote.classList.remove('over');
      return;
    }
    const over = len > IMAGE_MAX;
    imageNote.classList.toggle('over', over);
    if (over) {
      imageNoteText.textContent = `Too long for image (${len} / ${IMAGE_MAX}) — will send as text instead`;
      btnLabel.textContent = 'Send as text';
    } else {
      imageNoteText.textContent = `Best up to ${IMAGE_MAX} characters (${len} / ${IMAGE_MAX})`;
      btnLabel.textContent = 'Send';
    }
  }

  try {
    const saved = localStorage.getItem(DRAFT_KEY);
    if (saved) { message.value = saved; updateCounter(); }
  } catch (e) {}

  let saveTimer: number | undefined;
  message?.addEventListener('input', () => {
    updateCounter();
    updateImageNote();
    clearTimeout(saveTimer);
    saveTimer = window.setTimeout(() => {
      try { localStorage.setItem(DRAFT_KEY, message.value); } catch (e) {}
    }, 400);
  });

  asImage?.addEventListener('change', updateImageNote);

  message?.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      if (message.value.trim()) form.requestSubmit();
    }
  });

  async function generateCard(messageText: string): Promise<string | null> {
    try {
      await Promise.all([
        document.fonts.load('400 72px Fraunces'),
        document.fonts.load('400 28px Fraunces'),
      ]);
      await document.fonts.ready;
    } catch (e) {}

    const logo = await new Promise<HTMLImageElement | null>((resolve) => {
      const img = new Image();
      img.onload = () => resolve(img);
      img.onerror = () => resolve(null);
      img.src = '/logo-mark.png';
    });

    const W = 1080;
    const PAD_X = 100;
    const TOP_PAD = 140;
    const FOOTER_H = 260;
    const MIN_H = 720;
    const MAX_H = 3000;

    const canvas = document.createElement('canvas');
    let ctx = canvas.getContext('2d');
    if (!ctx) return null;

    function wrapText(c: CanvasRenderingContext2D, text: string, maxWidth: number): string[] {
      const out: string[] = [];
      for (const para of text.split('\n')) {
        if (para.trim() === '') { out.push(''); continue; }
        const words = para.split(/\s+/);
        let line = '';
        for (const word of words) {
          const test = line ? line + ' ' + word : word;
          if (c.measureText(test).width > maxWidth && line) {
            out.push(line);
            line = word;
          } else {
            line = test;
          }
        }
        if (line) out.push(line);
      }
      return out;
    }

    const maxTextWidth = W - PAD_X * 2;
    let fontSize = 72;
    let lineHeight = 74;
    let lines: string[] = [];
    let textBlockH = 0;

    for (let size = 72; size >= 28; size -= 2) {
      fontSize = size;
      lineHeight = Math.round(size * 1.28);
      const m = document.createElement('canvas');
      const mctx = m.getContext('2d')!;
      mctx.font = `400 ${fontSize}px Fraunces`;
      lines = wrapText(mctx, messageText, maxTextWidth);
      textBlockH = lines.length * lineHeight;
      const candidate = TOP_PAD + textBlockH + 60 + FOOTER_H;
      if (candidate <= MAX_H) break;
    }

    const contentH = textBlockH + 60;
    const H = Math.max(MIN_H, TOP_PAD + contentH + FOOTER_H);

    canvas.width = W;
    canvas.height = H;
    ctx = canvas.getContext('2d')!;

    // Light gradient background
    const grad = ctx.createLinearGradient(0, 0, W, H);
    grad.addColorStop(0, '#EEF5FB');
    grad.addColorStop(0.5, '#F7F2E5');
grad.addColorStop(1, '#FDF4DE');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    // Corner ornaments
    ctx.fillStyle = 'rgba(0, 84, 166, 0.08)';
    ctx.beginPath();
    ctx.arc(0, 0, 280, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = 'rgba(255, 199, 44, 0.10)';
    ctx.beginPath();
    ctx.arc(W, H, 320, 0, Math.PI * 2);
    ctx.fill();

    // Subtle gold accent line at the top
    ctx.fillStyle = 'rgba(255, 199, 44, 0.55)';

    // Message text
    const contentTop = TOP_PAD;
    const contentBottom = TOP_PAD + contentH;
    const contentMidY = (contentTop + contentBottom) / 2;
    const bodyStartY = contentMidY - textBlockH / 2 + lineHeight / 2;

    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.font = `400 ${fontSize}px Fraunces`;
    ctx.fillStyle = '#142B44';
    lines.forEach((line, i) => {
      ctx.fillText(line, W / 2, bodyStartY + i * lineHeight);
    });

    // Logo footer
    const footerCy = H - FOOTER_H / 2;
    if (logo) {
      const logoMaxW = 380;
      const logoMaxH = 100;
      const ratio = logo.width / logo.height;
      let lw = logoMaxW;
      let lh = lw / ratio;
      if (lh > logoMaxH) { lh = logoMaxH; lw = lh * ratio; }
      ctx.drawImage(logo, (W - lw) / 2, footerCy - lh / 2, lw, lh);
    } else {
      ctx.font = '400 46px Caprasimo';
      ctx.fillStyle = '#0054A6';
      ctx.fillText('SSU Freedom Wall', W / 2, footerCy);
    }

    const dataUrl = canvas.toDataURL('image/png');
    return dataUrl.split(',')[1];
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = message.value.trim();
    if (!msg) return;

    let imageBase64: string | null = null;
    let imageModeActive = asImage?.checked ?? false;

    // Soft-cap: if the message exceeds IMAGE_MAX, fall back to text
    if (imageModeActive && msg.length > IMAGE_MAX) {
      imageModeActive = false;
      if (asImage) asImage.checked = false;
      updateImageNote();
      showToast('Message is too long for an image — sending as text instead.');
    }

    if (imageModeActive) {
      imageBase64 = await generateCard(msg);
      if (!imageBase64) {
        alert('Could not generate the card. Try again or uncheck the image option.');
        return;
      }
    }

    (window as any).__finalText = msg;
    (window as any).__finalImage = imageBase64;
    document.getElementById('overlay')?.classList.add('open');
    window.dispatchEvent(new CustomEvent('confirm-open'));
  });

  function showToast(text: string) {
    const toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = text;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3500);
  }

  updateImageNote();
</script>
