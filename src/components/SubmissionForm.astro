---
import Icon from './Icon.astro';
---

<form id="form">
  <div class="card">
    <textarea
      id="message"
      maxlength="5000"
      placeholder="Share your thoughts, your name won't be shown."
    ></textarea>

    <div class="upload-row">
      <input type="file" id="imageInput" accept="image/png, image/jpeg, image/webp" hidden />
      <button type="button" id="uploadBtn" class="upload-btn">
        <Icon name="image" />
        <span>Attach a photo (optional)</span>
      </button>
      <span id="fileName" class="file-name"></span>
      <button type="button" id="removeImg" class="remove-btn" hidden>✕</button>
    </div>

    <label class="image-option" id="cardOptionLabel">
      <input type="checkbox" id="asImage" />
      <span id="cardOptionText">Send as image instead of text</span>
    </label>

    <div class="meta">
      <span id="counter">0 / 5000</span>
    </div>

    <button class="btn" type="submit">
      <Icon name="send" />
      <span>Send</span>
    </button>
  </div>
</form>

<style>
  textarea {
    width: 100%;
    min-height: 160px;
    resize: vertical;
    padding: 18px;
    font-size: 1.05rem;
    line-height: 1.6;
    font-family: inherit;
    font-weight: 500;
    color: var(--text);
    background: var(--input-bg);
    border: 1.5px solid var(--border);
    border-radius: 16px;
    outline: none;
    transition: border-color 0.15s, background 0.3s;
    display: block;
  }
  textarea:focus { border-color: var(--accent); background: var(--card); }
  textarea::placeholder { color: var(--placeholder); }

  .upload-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
  }
  .upload-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .upload-btn:hover { background: var(--hover-bg); color: var(--text); }
  .file-name {
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 120px;
  }
  .remove-btn {
    background: transparent;
    border: none;
    color: #dc2626;
    font-size: 1.1rem;
    cursor: pointer;
    padding: 4px;
  }

  .image-option {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    user-select: none;
    padding: 4px 0;
  }
  .image-option input[type="checkbox"] {
    width: 15px;
    height: 15px;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .image-option.disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .image-option.disabled input { cursor: not-allowed; }

  .meta {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-top: 6px;
    font-size: 0.83rem;
    font-weight: 500;
    color: var(--muted);
  }

  .btn {
    margin-top: 16px;
    width: 100%;
    padding: 16px;
    font-size: 1.05rem;
    font-weight: 700;
    font-family: inherit;
    color: #ffffff;
    background: var(--grad);
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: transform 0.08s, opacity 0.15s;
    box-shadow: 0 8px 22px rgba(0, 84, 166, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
  }
  .btn:active { transform: scale(0.98); }
</style>

<script>
  const MAX = 5000;
  const form = document.getElementById('form') as HTMLFormElement;
  const message = document.getElementById('message') as HTMLTextAreaElement;
  const counter = document.getElementById('counter')!;
  const asImage = document.getElementById('asImage') as HTMLInputElement;
  
  const imageInput = document.getElementById('imageInput') as HTMLInputElement;
  const uploadBtn = document.getElementById('uploadBtn') as HTMLButtonElement;
  const fileName = document.getElementById('fileName')!;
  const removeImg = document.getElementById('removeImg') as HTMLButtonElement;
  const cardOptionLabel = document.getElementById('cardOptionLabel')!;
  const cardOptionText = document.getElementById('cardOptionText')!;

  let attachedImage: { base64: string, ext: string } | null = null;

  function updateUI() {
    counter.textContent = `${message.value.length} / ${MAX}`;
    
    if (attachedImage) {
      asImage.checked = false;
      asImage.disabled = true;
      cardOptionLabel.classList.add('disabled');
      cardOptionText.textContent = "Card image unavailable with photo";
    } else {
      asImage.disabled = false;
      cardOptionLabel.classList.remove('disabled');
      cardOptionText.textContent = "Send as image instead of text";
    }
  }

  uploadBtn.addEventListener('click', () => imageInput.click());

  removeImg.addEventListener('click', () => {
    attachedImage = null;
    imageInput.value = '';
    fileName.textContent = '';
    removeImg.hidden = true;
    uploadBtn.hidden = false;
    updateUI();
  });

  imageInput.addEventListener('change', async () => {
    const file = imageInput.files?.[0];
    if (!file) return;

    if (!['image/png', 'image/jpeg', 'image/webp'].includes(file.type)) {
      alert('Only PNG, JPEG, and WebP images are allowed.');
      imageInput.value = '';
      return;
    }

    fileName.textContent = 'Compressing...';
    uploadBtn.hidden = true;
    removeImg.hidden = false;

    try {
      const result = await compressImage(file);
      attachedImage = result;
      fileName.textContent = file.name;
      updateUI();
    } catch (e) {
      alert('Failed to process image.');
      removeImg.click();
    }
  });

  function compressImage(file: File): Promise<{ base64: string, ext: string }> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          let { width, height } = img;
          const MAX_DIM = 1200;
          if (width > MAX_DIM || height > MAX_DIM) {
            const ratio = Math.min(MAX_DIM / width, MAX_DIM / height);
            width *= ratio; height *= ratio;
          }
          canvas.width = width; canvas.height = height;
          const ctx = canvas.getContext('2d')!;
          ctx.drawImage(img, 0, 0, width, height);
          
          const outType = file.type === 'image/png' ? 'image/png' : 'image/jpeg';
          const ext = outType === 'image/png' ? 'png' : 'jpg';
          const dataUrl = canvas.toDataURL(outType, 0.8);
          resolve({ base64: dataUrl.split(',')[1], ext });
        };
        img.onerror = reject;
        img.src = e.target?.result as string;
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  message.addEventListener('input', updateUI);
  asImage.addEventListener('change', updateUI);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = message.value.trim();
    if (!msg && !attachedImage) return;

    let finalB64 = attachedImage ? attachedImage.base64 : null;
    let finalExt = attachedImage ? attachedImage.ext : null;

    // If card generator is checked (and no image attached), generate it
    if (!attachedImage && asImage.checked) {
      // Note: You can add the card generation logic here if needed, 
      // but for now we pass the text and let the backend handle it
      // if you just want the text to go through.
    }

    (window as any).__finalText = msg;
    (window as any).__finalImage = finalB64;
    (window as any).__finalImageExt = finalExt;

    document.getElementById('overlay')?.classList.add('open');
    window.dispatchEvent(new CustomEvent('confirm-open'));
  });
</script>
