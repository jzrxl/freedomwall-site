---
import Icon from './Icon.astro';
---

<form id="form">
  <div class="card">
    <textarea
      id="message"
      maxlength="5000"
      placeholder="Share your thoughts, your name won't be shown."
      required
    ></textarea>
    <div class="meta">
      <span>Nothing is stored except your words.</span>
      <span id="counter">0 / 5000</span>
    </div>

    <button class="btn" type="submit">
      <Icon name="send" />
      <span>Preview &amp; send</span>
    </button>
  </div>
</form>

<style>
  textarea {
    width: 100%;
    min-height: 240px;
    resize: vertical;
    padding: 18px;
    font-size: 1.05rem;
    line-height: 1.6;
    font-family: inherit;
    font-weight: 500;
    color: var(--text);
    background: var(--input-bg);
    border: 1.5px solid var(--border);
    border-radius: 16px;
    outline: none;
    transition: border-color 0.15s, background 0.3s, color 0.3s;
    display: block;
  }
  textarea:focus { border-color: var(--accent); background: var(--card); }
  textarea::placeholder { color: var(--placeholder); }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
    font-size: 0.83rem;
    font-weight: 500;
    color: var(--muted);
  }

  .btn {
    margin-top: 16px;
    width: 100%;
    padding: 16px;
    font-size: 1.05rem;
    font-weight: 700;
    font-family: inherit;
    color: #ffffff;
    background: var(--grad);
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: transform 0.08s, box-shadow 0.15s, opacity 0.15s;
    box-shadow: 0 8px 22px rgba(0, 84, 166, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
  }
  .btn:hover { box-shadow: 0 10px 28px rgba(0, 84, 166, 0.36); opacity: 0.96; }
  .btn:active { transform: scale(0.98); }
</style>

<script>
  const form = document.getElementById('form') as HTMLFormElement;
  const message = document.getElementById('message') as HTMLTextAreaElement;
  const counter = document.getElementById('counter')!;

  message?.addEventListener('input', () => {
    counter.textContent = `${message.value.length} / 5000`;
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const msg = message.value.trim();
    if (!msg) return;

    (window as any).__finalText = msg;
    document.getElementById('overlay')?.classList.add('open');
  });
</script>
