---
import Icon from './Icon.astro';
---

<form id="form">
  <div class="card">
    <textarea
      id="message"
      maxlength="500"
      placeholder="Share your thoughts, your name won't be shown."
      required
    ></textarea>
    <div class="meta">
      <span>Nothing is stored except your words.</span>
      <span id="counter">0 / 500</span>
    </div>

    <button class="btn" type="submit">
      <Icon name="send" />
      <span>Preview &amp; send</span>
    </button>
  </div>
</form>

<style>
  textarea {
    width: 100%;
    min-height: 240px;
    resize: vertical;
    padding: 18px;
    font-size: 1.05rem;
    line-height: 1.6;
    font-family: inherit;
    font-weight: 500;
    color: #142B44;
    background: #F7FAFD;
    border: 1.5px solid #D5E3F2;
    border-radius: 16px;
    outline: none;
    transition: border-color 0.15s, background 0.15s;
    display: block;
    forced-color-adjust: none;
    color-scheme: only light;
  }
  textarea:focus { border-color: #0054A6; background: #ffffff; }
  textarea::placeholder { color: #9BB0C9; }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
    font-size: 0.83rem;
    font-weight: 500;
    color: #6B8099;
  }

  .btn {
    margin-top: 16px;
    width: 100%;
    padding: 16px;
    font-size: 1.05rem;
    font-weight: 700;
    font-family: inherit;
    color: #ffffff;
    background: var(--grad);
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: transform 0.08s, box-shadow 0.15s, opacity 0.15s;
    box-shadow: 0 8px 22px rgba(0, 84, 166, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    forced-color-adjust: none;
    color-scheme: only light;
  }
  .btn:hover { box-shadow: 0 10px 28px rgba(0, 84, 166, 0.36); opacity: 0.96; }
  .btn:active { transform: scale(0.98); }

  @media (prefers-color-scheme: dark) {
    textarea { background: #F7FAFD; color: #142B44; border-color: #D5E3F2; }
    .meta { color: #6B8099; }
    .btn { color: #ffffff; }
  }
</style>

<script>
  const form = document.getElementById('form') as HTMLFormElement;
  const message = document.getElementById('message') as HTMLTextAreaElement;
  const counter = document.getElementById('counter')!;

  message?.addEventListener('input', () => {
    counter.textContent = `${message.value.length} / 500`;
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const msg = message.value.trim();
    if (!msg) return;

    (window as any).__finalText = msg;
    (window as any).__previewMessage = msg;

    window.dispatchEvent(new CustomEvent('preview-ready'));
    document.getElementById('overlay')?.classList.add('open');
  });
</script>
